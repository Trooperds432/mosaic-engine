[Unit]
Description=Trading 212 DEMO bot (trades Mosaic research-engine signals)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/t212-bot
ExecStart=/opt/t212-bot/run.sh
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
